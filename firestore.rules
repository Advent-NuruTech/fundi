rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function role(uid) {
      return userDoc(uid).data.role;
    }

    function businessId(uid) {
      return userDoc(uid).data.businessId;
    }

    function roles(uid) {
      return userDoc(uid).data.roles;
    }

    function hasRole(uid, roleName) {
      return role(uid) == roleName || (roles(uid) is list && roles(uid).hasAny([roleName]));
    }

    function ownerOrAdmin(uid) {
      return hasRole(uid, 'owner') || hasRole(uid, 'admin_manager');
    }

    function canManageCustomers(uid) {
      return ownerOrAdmin(uid) || hasRole(uid, 'receptionist') || hasRole(uid, 'cashier');
    }

    function canManageOrders(uid) {
      return ownerOrAdmin(uid) || hasRole(uid, 'receptionist');
    }

    function canManageInventory(uid) {
      return ownerOrAdmin(uid) || hasRole(uid, 'inventory_manager');
    }

    function canManagePayments(uid) {
      return ownerOrAdmin(uid) || hasRole(uid, 'cashier') || hasRole(uid, 'receptionist');
    }

    function isOwnerProfile(data) {
      return data.role == 'owner' || (data.roles is list && data.roles.hasAny(['owner']));
    }

    function canUpdateAssignedOrder() {
      return hasRole(request.auth.uid, 'tailor') &&
        resource.data.assignedTailorId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['stage', 'deliveryStatus', 'productionNotes', 'fittingRecords', 'imageIds', 'updatedAt']);
    }

    function sameBusiness(bid) {
      return signedIn() && businessId(request.auth.uid) == bid;
    }

    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid ||
        (businessId(request.auth.uid) == resource.data.businessId && ownerOrAdmin(request.auth.uid))
      );
      allow create: if signedIn() && (
        request.auth.uid == uid ||
        (businessId(request.auth.uid) == request.resource.data.businessId && ownerOrAdmin(request.auth.uid) && !isOwnerProfile(request.resource.data))
      );
      allow update: if signedIn() && (
        request.auth.uid == uid ||
        (businessId(request.auth.uid) == resource.data.businessId && ownerOrAdmin(request.auth.uid) && !isOwnerProfile(resource.data) && !isOwnerProfile(request.resource.data))
      );
      allow delete: if false;
    }

    match /businesses/{bid} {
      allow read: if sameBusiness(bid);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if sameBusiness(bid) && ownerOrAdmin(request.auth.uid) &&
        request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if sameBusiness(bid) && hasRole(request.auth.uid, 'owner');

      match /members/{uid} {
        allow read: if sameBusiness(bid) && (request.auth.uid == uid || ownerOrAdmin(request.auth.uid));
        allow create: if sameBusiness(bid) && ownerOrAdmin(request.auth.uid) && !isOwnerProfile(request.resource.data);
        allow update: if sameBusiness(bid) && (
          hasRole(request.auth.uid, 'owner') ||
          (hasRole(request.auth.uid, 'admin_manager') && !isOwnerProfile(resource.data) && !isOwnerProfile(request.resource.data)) ||
          (
            request.auth.uid == uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'mustChangePassword', 'lastActiveAt'])
          )
        );
        allow delete: if sameBusiness(bid) && hasRole(request.auth.uid, 'owner') && !isOwnerProfile(resource.data);
      }

      match /invitations/{docId} {
        allow read, create: if sameBusiness(bid) && ownerOrAdmin(request.auth.uid);
        allow update: if sameBusiness(bid) && (
          ownerOrAdmin(request.auth.uid) ||
          (
            resource.data.invitedUid == request.auth.uid &&
            resource.data.status == 'pending' &&
            request.resource.data.status == 'accepted'
          )
        );
        allow delete: if sameBusiness(bid) && ownerOrAdmin(request.auth.uid);
      }

      match /customers/{docId} {
        allow read: if sameBusiness(bid);
        allow create, update: if sameBusiness(bid) && canManageCustomers(request.auth.uid);
        allow delete: if sameBusiness(bid) && ownerOrAdmin(request.auth.uid);
      }

      match /orders/{docId} {
        allow read: if sameBusiness(bid) && (
          !hasRole(request.auth.uid, 'tailor') || resource.data.assignedTailorId == request.auth.uid || ownerOrAdmin(request.auth.uid)
        );
        allow create: if sameBusiness(bid) && canManageOrders(request.auth.uid);
        allow update: if sameBusiness(bid) && (canManageOrders(request.auth.uid) || canUpdateAssignedOrder());
        allow delete: if sameBusiness(bid) && ownerOrAdmin(request.auth.uid);
      }

      match /inventory_materials/{docId} {
        allow read: if sameBusiness(bid);
        allow create, update: if sameBusiness(bid) && canManageInventory(request.auth.uid);
        allow delete: if sameBusiness(bid) && ownerOrAdmin(request.auth.uid);
      }

      match /fabric_rolls/{docId} {
        allow read: if sameBusiness(bid);
        allow create, update: if sameBusiness(bid) && canManageInventory(request.auth.uid);
        allow delete: if sameBusiness(bid) && ownerOrAdmin(request.auth.uid);
      }

      match /stock_movements/{docId} {
        allow read: if sameBusiness(bid);
        allow create: if sameBusiness(bid) && (canManageInventory(request.auth.uid) || canManageOrders(request.auth.uid));
        allow update, delete: if false;
      }

      match /purchase_orders/{docId} {
        allow read: if sameBusiness(bid);
        allow create, update: if sameBusiness(bid) && canManageInventory(request.auth.uid);
        allow delete: if sameBusiness(bid) && ownerOrAdmin(request.auth.uid);
      }

      match /suppliers/{docId} {
        allow read: if sameBusiness(bid);
        allow create, update: if sameBusiness(bid) && canManageInventory(request.auth.uid);
        allow delete: if sameBusiness(bid) && ownerOrAdmin(request.auth.uid);
      }

      match /payments/{docId} {
        allow read: if sameBusiness(bid);
        allow create: if sameBusiness(bid) && canManagePayments(request.auth.uid);
        allow update, delete: if false;
      }

      match /expenses/{docId} {
        allow read: if sameBusiness(bid) && (ownerOrAdmin(request.auth.uid) || hasRole(request.auth.uid, 'cashier'));
        allow create, update: if sameBusiness(bid) && ownerOrAdmin(request.auth.uid);
        allow delete: if sameBusiness(bid) && hasRole(request.auth.uid, 'owner');
      }

      match /withdrawals/{docId} {
        allow read: if sameBusiness(bid) && (ownerOrAdmin(request.auth.uid) || hasRole(request.auth.uid, 'cashier'));
        allow create, update: if sameBusiness(bid) && ownerOrAdmin(request.auth.uid);
        allow delete: if sameBusiness(bid) && hasRole(request.auth.uid, 'owner');
      }

      match /transactions/{docId} {
        allow read: if sameBusiness(bid) && (ownerOrAdmin(request.auth.uid) || hasRole(request.auth.uid, 'cashier'));
        allow create: if sameBusiness(bid) && ownerOrAdmin(request.auth.uid);
        allow update, delete: if false;
      }

      match /notifications/{docId} {
        allow read: if sameBusiness(bid) && resource.data.recipientUid == request.auth.uid;
        allow create: if sameBusiness(bid) && ownerOrAdmin(request.auth.uid);
        allow update, delete: if sameBusiness(bid) && resource.data.recipientUid == request.auth.uid;
      }

      match /images/{docId} {
        allow read, create: if sameBusiness(bid);
        allow delete: if sameBusiness(bid) && ownerOrAdmin(request.auth.uid);
        allow update: if false;
      }
    }
  }
}
